+    uint64_t ns_num = qemu_opt_get_number(opts, "ns-num", 0);
+    uint64_t ns_den = qemu_opt_get_number(opts, "ns-den", 0);
+
+    if ((ns_num == 0) != (ns_den == 0)) {
+        error_setg(errp, "icount: ns-num and ns-den must be specified together");
+        return;
+    }
+    if (ns_num && option && strcmp(option, "0") != 0) {
+        error_setg(errp, "icount: rational timing requires shift=0");
+        return;
+    }
 
     if (!option) {
         if (qemu_opt_get(opts, "align") != NULL) {
@@ -462,6 +506,8 @@ void icount_configure(QemuOpts *opts, Error **errp)
 
