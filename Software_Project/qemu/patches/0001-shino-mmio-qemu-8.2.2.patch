diff --git a/accel/tcg/icount-common.c b/accel/tcg/icount-common.c
index ec57192..7b89a9b 100644
--- a/accel/tcg/icount-common.c
+++ b/accel/tcg/icount-common.c
@@ -157,9 +157,36 @@ int64_t icount_get(void)
 
 int64_t icount_to_ns(int64_t icount)
 {
+    uint64_t num = qatomic_read(&timers_state.icount_ns_num);
+    uint64_t den = qatomic_read(&timers_state.icount_ns_den);
+
+    if (num && den) {
+        return (__int128)icount * num / den;
+    }
     return icount << qatomic_read(&timers_state.icount_time_shift);
 }
 
+int64_t icount_advance_virtual_time(int64_t target_ns)
+{
+    int64_t now;
+
+    if (!icount_enabled()) {
+        return qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    }
+    now = icount_get();
+    if (target_ns <= now) {
+        return now;
+    }
+    seqlock_write_lock(&timers_state.vm_clock_seqlock,
+                       &timers_state.vm_clock_lock);
+    qatomic_set_i64(&timers_state.qemu_icount_bias,
+                    timers_state.qemu_icount_bias + target_ns - now);
+    seqlock_write_unlock(&timers_state.vm_clock_seqlock,
+                         &timers_state.vm_clock_lock);
+    qemu_clock_notify(QEMU_CLOCK_VIRTUAL);
+    return target_ns;
+}
+
 /*
  * Correlation between real and virtual time is always going to be
  * fairly approximate, so ignore small variation.
@@ -226,6 +253,12 @@ static void icount_adjust_vm(void *opaque)
 
 int64_t icount_round(int64_t count)
 {
+    uint64_t num = qatomic_read(&timers_state.icount_ns_num);
+    uint64_t den = qatomic_read(&timers_state.icount_ns_den);
+
+    if (num && den) {
+        return ((__int128)count * den + num - 1) / num;
+    }
     int shift = qatomic_read(&timers_state.icount_time_shift);
     return (count + (1 << shift) - 1) >> shift;
 }
