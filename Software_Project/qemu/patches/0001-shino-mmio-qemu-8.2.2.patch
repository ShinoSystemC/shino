+#ifndef HW_MISC_SHINO_MMIO_H
+#define HW_MISC_SHINO_MMIO_H
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_SHINO_MMIO "shino-mmio"
+OBJECT_DECLARE_SIMPLE_TYPE(ShinoMmioState, SHINO_MMIO)
+
+struct ShinoMmioState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    MemoryRegion bram;
+    MemoryRegion cdma_iomem;
+    MemoryRegion cdma_bram;
+    MemoryRegion conv_bram;
+    uint64_t mmio_base;
+    uint64_t mmio_size;
+    uint64_t bram_base;
+    uint64_t bram_size;
+    uint64_t cdma_base;
+    uint64_t cdma_size;
+    uint64_t cdma_bram_base;
+    uint64_t cdma_bram_size;
+    uint64_t conv_bram_base;
+    uint64_t conv_bram_size;
+    char *shm_name;
+    char *bram_path;
+    char *cdma_bram_path;
+    char *conv_bram_path;
+    uint64_t timeout_ms;
+    bool advance_virtual_time;
+    int shm_fd;
+    void *transport;
+    QEMUTimer *completion_timer;
+    uint64_t sequence;
+};
+
+#endif
